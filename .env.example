MILO_HOST=localhost
MILO_PORT=25565
MILO_USERNAME=Milo
# Leave blank to let Mineflayer/server negotiate where possible.
MILO_VERSION=
# For offline-mode/local servers use: offline
# For Microsoft authentication use: microsoft
MILO_AUTH=offline
MILO_OWNER=
MILO_MEMORY_FILE=./data/memory.json


# Optional: generic HTTP vision analyzer for image -> build observations.
# Endpoint must accept JSON and return either { observations: {...} } or the observations object directly.
MILO_VISION_ENDPOINT=
MILO_VISION_API_KEY=
MILO_VISION_MODEL=
